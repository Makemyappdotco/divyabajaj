# Runtime
NODE_ENV=development
VERCEL_ENV=development
APP_BASE_URL=http://localhost:3000
REQUIRE_PERSISTENT_STORAGE=false
SYSTEM_PRODUCTION_READY=false

# Permanent database and private report storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_FREE_REPORTS=free-reports
SUPABASE_STORAGE_BUCKET_PAID_REPORTS=paid-reports

# Expiring report download links
# Use a separately generated long random value in Production.
REPORT_DOWNLOAD_SECRET=

# Admin authentication
# Temporary Basic Auth transition. No default password exists in code.
ADMIN_USERNAME=divya
ADMIN_PASSWORD=

# Report generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PAID_MODEL=gpt-5.5
ASTROLOGYAPI_MODE=sandbox
ASTROLOGYAPI_ACCESS_TOKEN=
ASTROLOGYAPI_V2_ACCESS_TOKEN=
ASTROLOGYAPI_PDF_SANDBOX_TOKEN=
# Keep false while testing API coverage. Set true before activating the final Personal Life Blueprint prompt.
PAID_REPORT_REQUIRE_VERIFIED_SOURCE=false
PAID_REPORT_PROMPT_VERSION=paid-v2-kp-source-v1

# Payment gateway. Final provider to be approved.
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email provider. Final provider to be approved.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Divya Bajaj <reports@divyabajaj.com>
EMAIL_REPLY_TO=contact@divyabajaj.com

# WhatsApp Cloud API
WHATSAPP_PROVIDER=meta_cloud
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Analytics
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
META_PIXEL_ID=
META_CONVERSIONS_API_TOKEN=

# Monitoring
SENTRY_DSN=
ALERT_EMAIL=contact@divyabajaj.com
