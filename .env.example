# Runtime
NODE_ENV=development
VERCEL_ENV=development
REQUIRE_PERSISTENT_STORAGE=false

# Permanent database and storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET_REPORTS=reports

# Admin authentication
# Temporary compatibility only. Replace Basic Auth with managed admin auth before handover.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Report generation
OPENAI_API_KEY=
OPENAI_REPORT_MODEL=
ASTROLOGYAPI_ACCESS_TOKEN=
ASTROLOGYAPI_V2_ACCESS_TOKEN=
